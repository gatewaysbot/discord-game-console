modules = ["python-3.11"]

[nix]
channel = "stable-24_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "DiscordBot"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "run_discord_bot"

[[workflows.workflow]]
name = "DiscordBot"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pip install discord.py && python bot.py"
waitForPort = 5000

[[workflows.workflow]]
name = "run_discord_bot"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python bot.py"

[deployment]
run = ["sh", "-c", "pip install discord.py && python bot.py"]
